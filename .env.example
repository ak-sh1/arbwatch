# Environment Variables

# Optional: PostgreSQL connection string
# Leave unset to run in replay mode with fixture data
# Example for Neon: postgresql://user:password@ep-cool-darkness-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Example for local: postgresql://postgres:postgres@localhost:5432/arbwatch
DATABASE_URL=

